# Applies identically to src/ and tests/. Two checks are disabled by context,
# not to lower the bar:
#   misc-include-cleaner  - IWYU-style; false positives on macOS POSIX symbols
#                           (strdup/open/popen/PATH_MAX are included yet flagged).
#   concurrency-mt-unsafe - the project is single-threaded (local CLI plus a
#                           fork/exec test harness); no shared-state reentrancy.
Checks: >
  -*,
  bugprone-*,
  cert-*,
  clang-analyzer-*,
  concurrency-*,
  misc-*,
  performance-*,
  portability-*,
  readability-*,
  -readability-magic-numbers,
  -readability-identifier-length,
  -bugprone-easily-swappable-parameters,
  -misc-no-recursion,
  -misc-include-cleaner,
  -concurrency-mt-unsafe,
  -clang-analyzer-security.insecureAPI.DeprecatedOrUnsafeBufferHandling

WarningsAsErrors: '*'
HeaderFilterRegex: '(src|tests)/.*'
FormatStyle: file

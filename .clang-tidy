# Maximum clang-tidy: enable every check, then subtract only the families that
# are structurally meaningless for a host C11 CLI (no meaningful code fix exists
# for them). Everything else is ON and driven green by real fixes; genuine false
# positives are silenced with a per-line NOLINT carrying a reason (see the
# NOLINT/NOLINTNEXTLINE sites in src/). Applies identically to src/ and tests/.
#
# Families subtracted (why a fix is impossible, not merely inconvenient):
#   altera-*                              Intel FPGA OpenCL/HLS checks. struct-pack-align
#                                         wants every struct packed+pow2-aligned for a
#                                         hardware memory interface; unroll-loops wants
#                                         #pragma unroll for FPGA pipelining;
#                                         id-dependent-backward-branch is about OpenCL
#                                         work-item IDs. None exist in a CPU CLI.
#   llvmlibc-restrict-system-libc-headers Forbids <stdio.h> etc.; exists so llvm-libc
#                                         avoids the system libc while implementing libc.
#                                         We are an application that must use it.
#   modernize-avoid-c-style-cast          Wants C++ static_cast<>/reinterpret_cast<>.
#   google-readability-casting            Same; C++ named casts do not exist in C11.
#   clang-analyzer-security.insecureAPI.DeprecatedOrUnsafeBufferHandling
#                                         Demands the C11 Annex K _s functions
#                                         (fprintf_s/memset_s/snprintf_s/memcpy_s).
#                                         Annex K is optional and unimplemented on
#                                         macOS, glibc, and musl (__STDC_LIB_EXT1__ is
#                                         undefined), so the suggested calls do not exist.
#                                         Buffers here are bounded by construction.
#   llvm-header-guard                     Derives the guard from the absolute file path
#                                         (e.g. TMP_..._SRC_STORE_H), which is
#                                         path-dependent and breaks across worktrees/CI
#                                         mounts. The existing REMEMBER_<FILE>_H guards
#                                         are correct and portable; no option strips the
#                                         path prefix.
Checks: >
  *,
  -altera-*,
  -llvmlibc-restrict-system-libc-headers,
  -modernize-avoid-c-style-cast,
  -google-readability-casting,
  -clang-analyzer-security.insecureAPI.DeprecatedOrUnsafeBufferHandling,
  -llvm-header-guard

WarningsAsErrors: '*'
# Match only project TUs under src/ and tests/ (flat layout). Do not use a bare
# 'src/' prefix: when Docker mounts the repo at /src, that also matches
# /src/third_party/... and clang-tidy then fails on the sqlite amalgamation.
HeaderFilterRegex: '(src|tests)/[^/]+\.(c|h)$'
FormatStyle: file

CheckOptions:
  - key: misc-include-cleaner.IgnoreHeaders
    value: '(sqlite3\.h|sys/.*|bits/.*|linux/.*|asm/.*|mach/.*|Availability.*|_.*)'
  - key: misc-include-cleaner.DeduplicateFindings
    value: 'true'
  # readability-identifier-length stays ON to catch genuinely cryptic short names on
  # new code, but the established one/two-letter idioms this codebase already uses are
  # allowlisted: single-letter scratch/loop/handle names (i j k n s e p q db...); a
  # letter+digit pair for numbered fixtures (a1 e2 g1 p3 r2 s1 — two entries, two graph
  # nodes, etc. in tests); and established two-letter idioms across src + tests:
  # status/return (st rc ns), id, date/time (yy mo ms at mi se tm ts), keys/hashes in
  # tests (ka kb kc kt hk hl hp hr hu), spans/sizes (sz cp), etc. A short name NOT in
  # this set is still flagged. Same idiom decision as the Swift .swiftlint.yml.
  - key: readability-identifier-length.IgnoredVariableNames
    value: '^(a|b|c|d|e|f|g|h|i|j|k|l|m|n|o|p|q|r|s|t|u|v|w|y|[a-z][0-9]|ab|ak|ar|at|av|bc|by|ca|cb|cc|ch|cp|cs|db|dn|ea|eb|ef|fd|fn|fp|hi|hk|hl|hp|hr|hu|id|in|ka|kb|kc|kt|lc|lo|lr|ls|mi|mo|ms|nb|nd|nm|ns|ob|of|pa|pn|pz|rc|rk|rr|rt|se|sn|sq|st|sz|tc|tm|to|ts|tt|wr|yy)$'
  - key: readability-identifier-length.IgnoredParameterNames
    value: '^(a|b|c|d|e|f|g|h|i|j|k|l|m|n|o|p|q|r|s|t|u|v|w|y|[a-z][0-9]|ab|ak|ar|at|av|bc|by|ca|cb|cc|ch|cp|cs|db|dn|ea|eb|ef|fd|fn|fp|hi|hk|hl|hp|hr|hu|id|in|ka|kb|kc|kt|lc|lo|lr|ls|mi|mo|ms|nb|nd|nm|ns|ob|of|pa|pn|pz|rc|rk|rr|rt|se|sn|sq|st|sz|tc|tm|to|ts|tt|wr|yy)$'

# Applies identically to src/ and tests/.
#
# Disabled by context (not to lower the bar):
#   concurrency-mt-unsafe — single-threaded CLI + fork/exec harness
#   clang-analyzer-security.insecureAPI.DeprecatedOrUnsafeBufferHandling —
#       flags snprintf/etc. that we intentionally use with known sizes
#
# IWYU-style include hygiene:
#   misc-include-cleaner is ON for project headers. System/POSIX false positives
#   are reduced via IgnoreHeaders; remaining noise uses NOLINTNEXTLINE sparingly.
Checks: >
  -*,
  bugprone-*,
  cert-*,
  clang-analyzer-*,
  concurrency-*,
  misc-*,
  performance-*,
  portability-*,
  readability-*,
  -readability-magic-numbers,
  -readability-identifier-length,
  -bugprone-easily-swappable-parameters,
  -misc-no-recursion,
  -concurrency-mt-unsafe,
  -clang-analyzer-security.insecureAPI.DeprecatedOrUnsafeBufferHandling

WarningsAsErrors: '*'
# Match only project TUs under src/ and tests/ (flat layout). Do not use a bare
# 'src/' prefix: when Docker mounts the repo at /src, that also matches
# /src/third_party/... and clang-tidy then fails on the sqlite amalgamation.
HeaderFilterRegex: '(src|tests)/[^/]+\.(c|h)$'
FormatStyle: file

CheckOptions:
  - key: misc-include-cleaner.IgnoreHeaders
    value: '(sqlite3\.h|sys/.*|bits/.*|linux/.*|asm/.*|mach/.*|Availability.*|_.*)'
  - key: misc-include-cleaner.DeduplicateFindings
    value: 'true'
